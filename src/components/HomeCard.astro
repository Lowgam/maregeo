---
const {
    title,
    text,
    image,
    href
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const cardHref = `${base}${href.replace(/^\//, "")}`;
const cardImage = `${base}${image.replace(/^\//, "")}`;
---

<a href={cardHref} class="home-card">
    <img
        class="home-card__image"
        src={cardImage}
        alt={title}
    />

    <div class="home-card__content">
        <h2>{title}</h2>

        {text && <p>{text}</p>}
    </div>
</a>