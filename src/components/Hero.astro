---
const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<section class="hero">
    <div class="hero__slides">
        <img
            class="hero__image"
            src={`${base}images/hero/Hero_0.jpg`}
            alt="Prodotti Maregeo"
        />

        <img
            class="hero__image"
            src={`${base}images/hero/Hero_1.jpg`}
            alt="Prodotti Maregeo"
        />

        <img
            class="hero__image"
            src={`${base}images/hero/Hero_2.jpg`}
            alt="Prodotti Maregeo"
        />

        <img
            class="hero__image"
            src={`${base}images/hero/Hero_3.jpg`}
            alt="Prodotti Maregeo"
        />

        <img
            class="hero__image"
            src={`${base}images/hero/Hero_4.jpg`}
            alt="Prodotti Maregeo"
        />

        <img
            class="hero__image"
            src={`${base}images/hero/Hero_5.jpg`}
            alt="Prodotti Maregeo"
        />

        <!-- Copia della prima immagine per il loop infinito -->
        <img
            class="hero__image"
            src={`${base}images/hero/Hero_0.jpg`}
            alt="Prodotti Maregeo"
        />
    </div>

    <div class="hero__fade"></div>

    <div class="hero__logo">
        <a href={base}>
            <img
                src={`${base}images/logo/maregeo-logo.png`}
                alt="Logo Maregeo"
            />
        </a>
    </div>
</section>

<script>
    const slides = document.querySelector<HTMLElement>(".hero__slides");
    const images = document.querySelectorAll(".hero__image");

    if (slides) {
        let currentSlide = 0;

        setInterval(() => {
            currentSlide++;

            slides.style.transition = "transform 0.8s ease-in-out";
            slides.style.transform = `translateX(-${currentSlide * 100}%)`;

            if (currentSlide === images.length - 1) {
                setTimeout(() => {
                    slides.style.transition = "none";
                    currentSlide = 0;
                    slides.style.transform = "translateX(0)";
                }, 800);
            }
        }, 5000);
    }
</script>